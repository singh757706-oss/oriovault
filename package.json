{
  "name":"oriovault",
  "version":"1.0.0",
  "private":true,
  "scripts":{
    "install:all":"npm install && npm --prefix backend install",
    "dev":"concurrently \"npm run chain\" \"npm run backend\" \"npm run frontend\"",
    "chain":"npx hardhat node",
    "deploy":"npx hardhat run scripts/deploy.js --network localhost",
    "backend":"npm --prefix backend start",
    "frontend":"npx serve frontend -l 5173",
    "test:contract":"npx hardhat test"
  },
  "devDependencies":{
    "@nomicfoundation/hardhat-toolbox":"^5.0.0",
    "hardhat":"^2.22.15",
    "concurrently":"^9.0.1",
    "serve":"^14.2.4"
  }
}
